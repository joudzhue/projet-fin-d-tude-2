# Activation
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Domaine public et WebAuthn (remplacer example.com)
FRONTEND_URL=https://example.com
WEBAUTHN_RP_ID=example.com
WEBAUTHN_ORIGINS=https://example.com
VITE_API_URL=/api

# Base MySQL
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Flyway : conserver false, sauf adoption ponctuelle et contrôlée d'une base historique
FLYWAY_BASELINE_ON_MIGRATE=false

# Sécurité
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Protection locale mono-instance des endpoints publics
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_LOGIN_REQUESTS=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_ASSISTANT_REQUESTS=15
RATE_LIMIT_ASSISTANT_WINDOW_SECONDS=60
RATE_LIMIT_QUOTE_REQUESTS=10
RATE_LIMIT_QUOTE_WINDOW_SECONDS=600
RATE_LIMIT_DOCUMENT_REQUESTS=10
RATE_LIMIT_DOCUMENT_WINDOW_SECONDS=600
RATE_LIMIT_UPLOAD_REQUESTS=12
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600

# Bootstrap ponctuel du premier Admin — retirer le mot de passe après création
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=Administrateur G-ROD

# Fichiers
UPLOAD_DIR=/var/lib/grod/uploads
UPLOAD_TEMP_RETENTION_HOURS=24
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_CLEANUP_INTERVAL_MS=21600000

# Sauvegardes — peut être placé dans /etc/grod/backup.env séparé
BACKUP_DIR=/var/backups/grod
BACKUP_RETENTION_DAYS=14

# Swagger et logs SQL (désactivés en production)
SWAGGER_ENABLED=false
SHOW_SQL=false

# Email
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
ADMIN_NOTIFICATION_EMAIL=

# SMS / Twilio
SMS_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_NOTIFICATION_PHONE=

# Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
